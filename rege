Add-Type @"
using System;
using System.Runtime.InteropServices;
public class Win32 {
    [DllImport("user32.dll")]
    public static extern short GetAsyncKeyState(int vKey);

    [DllImport("user32.dll")]
    public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);

    [DllImport("winmm.dll")]
    public static extern uint timeBeginPeriod(uint uMilliseconds);

    [DllImport("kernel32.dll")]
    public static extern void Sleep(uint dwMilliseconds);

    public const int LEFTDOWN  = 0x02;
    public const int LEFTUP    = 0x04;
    public const int RIGHTDOWN = 0x08;
    public const int RIGHTUP   = 0x10;
}
"@

# 1. Force High Precision for sub-10ms delays
[Win32]::timeBeginPeriod(1)

# 2. Prevent Windows Efficiency Mode Throttling
$process = [System.Diagnostics.Process]::GetCurrentProcess()
$process.PriorityClass = [System.Diagnostics.ProcessPriorityClass]::RealTime

# 3. Ported Logic from 25.xml
$config = @(
    @(16,46), @(15,51), @(17,45), @(16,49), @(14,53), @(17,47), @(15,50), @(16,46), @(18,44), @(15,52),
    @(16,48), @(14,55), @(17,46), @(15,51), @(16,47), @(15,53), @(17,44), @(16,50), @(14,52), @(18,46),
    @(15,49), @(16,53), @(17,45), @(15,51), @(16,48), @(14,54), @(17,47), @(15,49), @(16,52), @(15,46),
    @(18,45), @(14,53), @(16,49), @(17,46), @(15,52), @(16,47), @(15,54), @(17,45), @(14,51), @(16,50),
    @(15,48), @(17,52), @(14,46), @(16,53), @(15,49), @(17,47), @(16,51), @(14,54), @(18,44), @(15,50),
    @(16,47), @(17,52), @(14,49), @(16,46), @(15,53), @(17,45), @(15,51), @(16,48), @(14,52)
)


$idx = 0
$rand = New-Object System.Random

Write-Host "takizo fute mamele la toti" -ForegroundColor Red
Write-Host "Mouse 4 -> pui blocuri ca spartu | Mouse 5 -> futi mamele la toti" -ForegroundColor Green
Write-Host "Apasa F12 to sa inchizi pisatu asta de cod" -ForegroundColor Yellow

while ($true) {
    if ([Win32]::GetAsyncKeyState(0x7B) -lt 0) { break } # F12 Exit

    # Triggered by Mouse 4 (0x05) or Mouse 5 (0x06)
    $m4 = [Win32]::GetAsyncKeyState(0x05) -lt 0 
    $m5 = [Win32]::GetAsyncKeyState(0x06) -lt 0 

    if ($m4 -or $m5) {
        $pair = $config[$idx % $config.Count]
        $idx++

        # Jitter logic from original script
        $downDelay = [Math]::Max(1, $pair[0] + $rand.Next(-1, 2))
        $upDelay   = [Math]::Max(1, $pair[1] + $rand.Next(-1, 2))

        # Button Assignment Swapped:
        # If M4 (0x05) is pressed -> Right Click (0x08/0x10)
        # If M5 (0x06) is pressed -> Left Click (0x02/0x04)
        $downFlag = if ($m4) { 0x08 } else { 0x02 }
        $upFlag   = if ($m4) { 0x10 } else { 0x04 }

        # Execution
        [Win32]::mouse_event($downFlag, 0, 0, 0, 0)
        [Win32]::Sleep($downDelay)
        [Win32]::mouse_event($upFlag, 0, 0, 0, 0)
        [Win32]::Sleep($upDelay)
    }
    else {
        [Win32]::Sleep(1)
    }
}
